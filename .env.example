# ==============================================================
# DuoSpend - File di Configurazione Produzione / Ubuntu Server
# ==============================================================

# 1. Porta e Ambiente
PORT=3000
NODE_ENV=production

# 2. Google OAuth 2.0 Web Client ID & Secret (Frontend & Session Auth)
# Configura un ID client OAuth 2.0 (Applicazione Web) su Google Cloud Console.
# Inserisci il dominio di produzione nelle 'Origini JavaScript autorizzate' (es. https://duospend.tuodominio.it).
# N.B. In fase di compilazione frontend (npm run build), VITE_GOOGLE_CLIENT_ID viene iniettata nel client.
# Con GOOGLE_CLIENT_SECRET impostato, il backend attiva il Code Model GIS (cookie HttpOnly + refresh automatico lato server).
VITE_GOOGLE_CLIENT_ID="il-tuo-client-id-google.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="il-tuo-client-secret-google"

# 3. Gemini AI API Key (per categorizzazione AI, OCR scontrini e Vision Board)
# Generata su Google AI Studio (https://aistudio.google.com/).
GEMINI_API_KEY="AIzaSy..."

# 4. Secret per Webhook Android / SMS Bancari (opzionale)
# Password segreta per consentire a MacroDroid o Tasker di inviare le notifiche bancarie direttamente via POST /api/notifications/ingest
DUOSPEND_WEBHOOK_SECRET="inserisci-una-stringa-segreta-casuale-qui"

# 5. Percorso Database SQLite (in Docker: /app/data/duospend.sqlite)
# Percorso assoluto o relativo con estensione .sqlite o .db (fallback locale: ./data/duospend.sqlite)
DB_PATH="/app/data/duospend.sqlite"
# DUOSPEND_DB_FILE="./duospend.sqlite"

# 6. Password Console Sviluppatore & Gestione Database (Opzionale)
# Se lasciata vuota, in produzione la console sviluppatore resta disabilitata (404).
# Se impostata (consigliati 12+ caratteri in produzione), abilita il menu "Strumenti dev" dopo il login Google
# e richiede questa password per accedere a diagnostica, backup JSON e reset del database (con conferma "RESET").
DUOSPEND_DEV_PASSWORD=""

# 7. Durata Sessione Utente Google (Opzionale)
# Timeout di inattività (minuti, default 30, range 5-240) e limite massimo assoluto (ore, default 4, range 1-12).
# DUOSPEND_SESSION_IDLE_MINUTES=30
# DUOSPEND_SESSION_MAX_HOURS=4

# 8. Sincronizzazione con Server Ubuntu Secondario (Opzionale)
# DUOSPEND_UBUNTU_SERVER_URL="http://192.168.1.100:3000"
# DUOSPEND_UBUNTU_TOKEN="token-se-impostato"
