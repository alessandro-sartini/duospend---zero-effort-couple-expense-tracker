{
  "name": "DuoSpend — Spese di Coppia 50/50",
  "short_name": "DuoSpend",
  "description": "Gestione spese di coppia a zero fatica: scansione Gmail, scontrini OCR, notifiche/SMS Android 1-tap, budget condivisi e pareggio 50/50.",
  "lang": "it-IT",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait-primary",
  "background_color": "#131210",
  "theme_color": "#131210",
  "categories": ["finance", "productivity", "lifestyle"],
  "icons": [
    {
      "src": "/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Nuova Spesa",
      "short_name": "Nuova Spesa",
      "description": "Inserisci una nuova spesa condivisa",
      "url": "/?action=add-expense",
      "icons": [
        { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" },
        { "src": "/icon.svg", "sizes": "any", "type": "image/svg+xml" }
      ]
    },
    {
      "name": "Incolla Notifica / SMS",
      "short_name": "Notifiche",
      "description": "Decodifica una notifica o SMS bancario",
      "url": "/?action=paste-notification",
      "icons": [
        { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" },
        { "src": "/icon.svg", "sizes": "any", "type": "image/svg+xml" }
      ]
    },
    {
      "name": "Scansiona Scontrino",
      "short_name": "Fotocamera",
      "description": "Acquisisci uno scontrino con OCR",
      "url": "/?action=scan-receipt",
      "icons": [
        { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" },
        { "src": "/icon.svg", "sizes": "any", "type": "image/svg+xml" }
      ]
    },
    {
      "name": "Pareggio Saldo",
      "short_name": "Saldo",
      "description": "Controlla i conti e registra un rimborso",
      "url": "/saldo",
      "icons": [
        { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" },
        { "src": "/icon.svg", "sizes": "any", "type": "image/svg+xml" }
      ]
    }
  ],
  "share_target": {
    "action": "/",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  }
}
